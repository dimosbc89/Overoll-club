# Copy to .env.local (git-ignored). Names only: never commit real values.
# Supabase project URL and its *publishable* key (never the service-role key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: the club site, e.g. club.<overoll domain> (copy deck {clubUrl}).
EXPO_PUBLIC_CLUB_URL=
