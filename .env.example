# Names only. Real values live in .env (ignored by git) and in Supabase secrets.

# Supabase project "overoll-club" (GROW Agency org, eu-central-1)
SUPABASE_URL=https://lwhxqnmntihmavqngeca.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server functions only, never in an app:
SUPABASE_SERVICE_ROLE_KEY=

# apps/mobile (Expo: iOS, Android, web app). Put these in apps/mobile/.env.local.
# EXPO_PUBLIC_* values are built into the app; only the publishable key goes here.
EXPO_PUBLIC_SUPABASE_URL=https://lwhxqnmntihmavqngeca.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# apps/admin (Next.js back office). Put these in apps/admin/.env.local.
# NEXT_PUBLIC_* values are baked in at build time: set them before `next build`.
NEXT_PUBLIC_SUPABASE_URL=https://lwhxqnmntihmavqngeca.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Apple Wallet (GROW's Apple Developer account)
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.online.growagency.overoll
APPLE_PASS_CERT_P12_BASE64=
APPLE_PASS_CERT_PASSWORD=

# Google Wallet (GROW's Google Pay & Wallet Console)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=

# Signs member QR tokens (packages/core member-token), 32+ random bytes, hex
MEMBER_TOKEN_SECRET=
