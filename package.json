{
  "name": "overoll-club",
  "private": true,
  "version": "0.1.0",
  "description": "Overoll Club loyalty platform: apps, wallet passes, web app and back office",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run seed:check && npm run project:check",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "test:db": "bash supabase/tests/run-local.sh",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "seed:check": "tsx scripts/generate-seed.ts --check",
    "functions:build": "tsx scripts/build-functions.ts",
    "project:check": "tsx scripts/configure-project.ts --check",
    "project:apply": "tsx scripts/configure-project.ts --apply",
    "build:web:mobile": "tsx scripts/build-web.ts mobile",
    "build:web:admin": "tsx scripts/build-web.ts admin",
    "migrations:apply": "tsx scripts/apply-migrations.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
